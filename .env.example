# App
NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=constructos

# JWT — CHANGE THESE IN PRODUCTION (use: openssl rand -base64 64)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# SuperAdmin seed credentials — CHANGE IN PRODUCTION
SUPERADMIN_EMAIL=admin@constructos.app
SUPERADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Redis (optional — for future queue/cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3 (for file uploads — optional)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=constructos-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
